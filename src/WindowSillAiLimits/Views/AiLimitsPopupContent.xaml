<?xml version="1.0" encoding="utf-8" ?>
<api:SillPopupContent
    x:Class="WindowSillAiLimits.Views.AiLimitsPopupContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:WindowSill.API"
    Width="760">

    <Border
        x:Name="RootBorder"
        Padding="14"
        BorderThickness="1"
        CornerRadius="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="RootPanel" Spacing="12">
                <Grid x:Name="HeaderGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center"
                        Grid.Column="0">
                        <Border
                            Width="10"
                            Height="28"
                            CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#36D6AA" Offset="0" />
                                    <GradientStop Color="#EEB157" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <TextBlock
                            x:Name="TitleText"
                            api:Uids.Uid="/WindowSillAiLimits/Resources/DisplayName"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="AI Limits" />
                    </StackPanel>

                    <TextBlock
                        x:Name="UpdatedText"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />

                    <Button
                        x:Name="RefreshIconButton"
                        api:Uids.Uid="/WindowSillAiLimits/Resources/Popup.RefreshButton"
                        Grid.Column="2"
                        Padding="8,4,8,4"
                        VerticalAlignment="Center">
                        <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    </Button>
                </Grid>

                <Grid x:Name="ProviderGrid" />
                <Grid x:Name="ApiCostGrid" />
                <Grid x:Name="FooterGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</api:SillPopupContent>
